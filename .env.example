# --- Application ---------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api/v1

# --- Database ------------------------------------------------------------------
# Local docker-compose postgres (mapped to 5433 to avoid clashing with a local 5432)
DATABASE_URL=postgresql+psycopg://career:career@localhost:5433/career

# --- Storage -------------------------------------------------------------------
STORAGE_DIR=./storage
MAX_UPLOAD_BYTES=10485760

# --- AI provider ---------------------------------------------------------------
# "offline" runs a deterministic heuristic provider: no API key, no network.
# Switch to "openai" (or any OpenAI-compatible endpoint) for real LLM output.
AI_PROVIDER=offline
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=1

# --- Matching weights (must sum to > 0; normalised automatically) --------------
MATCH_WEIGHT_TECHNICAL=0.40
MATCH_WEIGHT_EXPERIENCE=0.25
MATCH_WEIGHT_EDUCATION=0.10
MATCH_WEIGHT_LOCATION=0.10
MATCH_WEIGHT_OTHER=0.15

# --- Recommendation thresholds --------------------------------------------------
THRESHOLD_APPLY=80
THRESHOLD_APPLY_WITH_TAILORING=65
THRESHOLD_STRETCH=50
# --- Optional Careerjet / Optioncarriere publisher fallback for Benin -----------
# Requires an approved publisher account and registered referral page.
# Set all four or none. For a *single trusted local user*, supply the real
# current public IP and actual browser User-Agent; never use 127.0.0.1,
# Docker's bridge address, a proxy IP, or a made-up identity. This metadata
# is transmitted to Careerjet only when the keyless Benin source returns zero.
# Review https://www.optioncarriere.bj/partners/api/python and publisher terms.
CAREERJET_PUBLISHER_KEY=
CAREERJET_USER_IP=
CAREERJET_USER_AGENT=
CAREERJET_REFERER=
